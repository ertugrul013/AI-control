# Database. docker compose points the app at its own "db" service automatically;
# DATABASE_URL below is only used when you run the app outside Docker.
POSTGRES_PASSWORD=aicontrol
DATABASE_URL=postgresql://aicontrol:aicontrol@localhost:5432/aicontrol

# Session signing secret. Replace before real use: openssl rand -base64 32
AUTH_SECRET=change-me-before-real-use-openssl-rand-base64-32

# true: load the demo organization on first start. false: start empty and show the /setup wizard.
SEED_DEMO=true

# Optional single sign-on through OIDC (for example Microsoft Entra ID). Leave empty to disable.
# Users must already exist in AIControl with the same email address.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_NAME=
