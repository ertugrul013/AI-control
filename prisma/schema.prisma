generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  EDITOR
  VIEWER
  EMPLOYEE
}

enum Locale {
  nl
  en
}

enum UsageType {
  THIRD_PARTY_TOOL
  EMBEDDED_IN_SAAS
  IN_HOUSE
}

enum DataCategory {
  NONE
  BUSINESS
  PERSONAL
  SENSITIVE_PERSONAL
}

enum UserGroup {
  INTERNAL
  CUSTOMERS
  PUBLIC
}

enum SystemStatus {
  PROPOSED
  APPROVED
  IN_USE
  RETIRED
}

enum Tier {
  PROHIBITED
  HIGH
  LIMITED
  MINIMAL
}

enum ActionStatus {
  OPEN
  DONE
}

enum PolicyStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum Audience {
  ALL
  POWER_USERS
  MANAGEMENT
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  APPROVE
  PUBLISH
  EXPORT
}

model Organization {
  id            String   @id @default(cuid())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  name          String
  sector        String
  employeeCount Int
  country       String
  defaultLocale Locale   @default(nl)
}

model User {
  id                 String   @id @default(cuid())
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  name               String
  email              String   @unique
  passwordHash       String
  mustChangePassword Boolean  @default(true)
  role               Role
  department         String   @default("")
  locale             Locale   @default(nl)

  ownedSystems        AiSystem[]
  assessments         RiskAssessment[]        @relation("assessor")
  approvals           RiskAssessment[]        @relation("approver")
  actions             Action[]
  trainingAssignments TrainingAssignment[]
  acknowledgements    PolicyAcknowledgement[]
  auditEntries        AuditLog[]
}

model AiSystem {
  id             String         @id @default(cuid())
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  name           String
  vendor         String
  description    String
  purpose        String
  department     String
  ownerId        String
  owner          User           @relation(fields: [ownerId], references: [id])
  usageType      UsageType
  dataCategories DataCategory[]
  userGroup      UserGroup
  status         SystemStatus
  nextReviewDate DateTime?

  assessments RiskAssessment[]
  actions     Action[]
}

model RiskAssessment {
  id           String    @id @default(cuid())
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  aiSystemId   String
  aiSystem     AiSystem  @relation(fields: [aiSystemId], references: [id], onDelete: Cascade)
  answers      Json
  resultTier   Tier
  rationale    Json
  assessedById String
  assessedBy   User      @relation("assessor", fields: [assessedById], references: [id])
  approvedById String?
  approvedBy   User?     @relation("approver", fields: [approvedById], references: [id])
  approvedAt   DateTime?
  version      Int

  @@unique([aiSystemId, version])
}

model Action {
  id          String       @id @default(cuid())
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  aiSystemId  String?
  aiSystem    AiSystem?    @relation(fields: [aiSystemId], references: [id], onDelete: Cascade)
  // Set for actions generated by the classification engine; the title is then rendered from the rule texts.
  actionKey   String?
  title       String
  description String       @default("")
  dueDate     DateTime
  assigneeId  String
  assignee    User         @relation(fields: [assigneeId], references: [id])
  status      ActionStatus @default(OPEN)
}

model Policy {
  id              String       @id @default(cuid())
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  version         Int          @unique
  locale          Locale
  title           String
  contentMarkdown String
  wizardAnswers   Json
  status          PolicyStatus @default(DRAFT)
  publishedAt     DateTime?

  acknowledgements PolicyAcknowledgement[]
}

model PolicyAcknowledgement {
  id             String   @id @default(cuid())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  policyId       String
  policy         Policy   @relation(fields: [policyId], references: [id], onDelete: Cascade)
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  acknowledgedAt DateTime @default(now())

  @@unique([policyId, userId])
}

model TrainingModule {
  id               String   @id @default(cuid())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  slug             String   @unique
  titleNl          String
  titleEn          String
  contentNl        String
  contentEn        String
  quiz             Json
  estimatedMinutes Int
  audience         Audience

  assignments TrainingAssignment[]
}

model TrainingAssignment {
  id          String         @id @default(cuid())
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  moduleId    String
  module      TrainingModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  userId      String
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedAt  DateTime       @default(now())
  dueDate     DateTime
  completedAt DateTime?
  score       Int?

  @@unique([moduleId, userId])
}

// Append-only: no service updates or deletes rows in this table.
model AuditLog {
  id         String      @id @default(cuid())
  timestamp  DateTime    @default(now())
  actorId    String?
  actor      User?       @relation(fields: [actorId], references: [id], onDelete: SetNull)
  entityType String
  entityId   String
  action     AuditAction
  diff       Json

  @@index([entityType, entityId])
  @@index([timestamp])
}
